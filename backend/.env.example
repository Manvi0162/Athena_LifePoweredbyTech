# Copy to backend/.env (never commit .env). Leave Supabase empty to run in LOCAL mode (accounts in local files).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
GEMINI_API_KEY=
# Optional: Gemini models to try in order
# GEMINI_TEXT_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.8-flash
# Local mode demo account (ignored when Supabase is set)
LIVEBETTER_EMAIL=demo@livebetter.mu
LIVEBETTER_PASSWORD=demo1234
# Signs local login tokens and pattern permissions. Use any long random text, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
LIVEBETTER_SECRET=change-me
# Encrypts each user's authenticator secret. REQUIRED in Supabase mode; in local mode a key file is created
# in backend/.localdata/mfa.key. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=
# Food photo recognition (Shruti's module): providers tried in this order, each needs its key
# FOOD_VISION_PROVIDERS=groq,gemini,openrouter
GROQ_API_KEY=
OPENROUTER_API_KEY=
