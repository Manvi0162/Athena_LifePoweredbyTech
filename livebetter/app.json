{
  "expo": {
    "name": "LiveBetter",
    "slug": "livebetter-hackathon",
    "scheme": "livebetter",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.livebetter.hackathon2026",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "LiveBetter uses the camera to photograph receipts and bills."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "585c360b-3369-4754-bb00-0491354918b3"
      }
    }
  }
}
